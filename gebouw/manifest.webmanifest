{
  "name": "Kringo Gebouw",
  "short_name": "Kringo Gebouw",
  "description": "Kringo Gebouw – elektrische installaties van woningen en gebouwen (AREI) in de browser",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eef1f5",
  "theme_color": "#14706b",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "../icons/gebouw-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/gebouw-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/gebouw-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/gebouw.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-kringo": [
          ".kringo",
          ".elecad"
        ]
      }
    }
  ]
}
