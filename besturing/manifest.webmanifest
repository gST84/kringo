{
  "name": "Kringo Besturing",
  "short_name": "Kringo Besturing",
  "description": "Kringo Besturing – stuurkasten, hydraulica, pneumatica en machinekoeling tekenen en simuleren in de browser",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eef1f5",
  "theme_color": "#17457f",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "../icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-kringo": [
          ".kringo",
          ".elecad"
        ],
        "application/x-qelectrotech": [
          ".qet"
        ]
      }
    }
  ]
}
